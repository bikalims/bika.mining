<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="bika.mining">

  <include package="senaite.core.permissions" />
  <adapter name="Matrix_References"
      factory=".overrides.setupdata.Matrix_References"
      provides="bika.lims.interfaces.ISetupDataImporter"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot" />
  <browser:page for="bika.mining.interfaces.IMatrixReferences"
      name="view" class=".matrixreferences.MatrixReferencesView"
      permission="senaite.core.permissions.ManageBika"
      layer="bika.mining.interfaces.IBikaMiningLayer" />
  <browser:page for="bika.mining.interfaces.IShifts"
      name="view" class=".matrixreferences.ShiftsView"
      permission="senaite.core.permissions.ManageBika"
      layer="bika.mining.interfaces.IBikaMiningLayer" />
  <browser:page for="bika.mining.interfaces.IClassifications"
      name="view" class=".matrixreferences.ClassificationsView"
      permission="senaite.core.permissions.ManageBika"
      layer="bika.mining.interfaces.IBikaMiningLayer" />
  <browser:page for="bika.mining.interfaces.IDrumBatches"
      name="view" class=".matrixreferences.DrumBatchesView"
      permission="senaite.core.permissions.ManageBika"
      layer="bika.mining.interfaces.IBikaMiningLayer" />

  <!-- Set overrides folder for Just-a-Bunch-Of-Templates product -->
  <include package="z3c.jbot" file="meta.zcml" />
  <browser:jbot
      directory="overrides"
      layer="bika.mining.interfaces.IBikaMiningLayer"
      />

  <!-- Publish static files -->
  <plone:static
      name="bika.mining"
      type="plone"
      directory="static"
      />

</configure>

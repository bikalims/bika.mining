<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="bika.mining">

  <i18n:registerTranslations directory="locales" />

  <!--
    Be careful if you use general includeDependencies, it can have side effects!
    Better import explicit packages or configurations ;)
  -->
  <!--<includeDependencies package="." />-->

  <include package=".browser" />
  <include package=".extenders" />

  <adapter name="bika.mining.matrixreference.info"
      for=".interfaces.IMatrixReference"
      provides="bika.lims.interfaces.IAddSampleObjectInfo"
      factory=".adapters.MatrixReferenceInfo" />
  <adapter name="bika.mining.sampletemplate.info"
      for="senaite.core.interfaces.ISampleTemplate"
      provides="bika.lims.interfaces.IAddSampleObjectInfo"
      factory=".adapters.SampleTemplateInfo" />
  <subscriber for="bika.lims.interfaces.IAnalysisRequest
                   zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".events.initialize_sample" />
  <subscriber for="senaite.core.interfaces.ISampleTemplate
                   zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".events.populate_sample_template" />
  <subscriber for="senaite.core.interfaces.ISampleTemplate
                   zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".events.populate_sample_template" />
  <subscriber for="bika.lims.interfaces.IAnalysisRequest
                   Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".events.after_transition" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="BIKA MINING"
      directory="profiles/default"
      description="Installs the bika.mining add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="bika.mining (uninstall)"
      directory="profiles/uninstall"
      description="Uninstalls the bika.mining add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.uninstall"
      />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="bika.mining-hiddenprofiles"
      />

  <!-- -*- extra stuff goes here -*- -->
  <genericsetup:upgradeStep title="Install mining sample attributes"
      description="Add mining lookup tables and template defaults"
      source="1000" destination="1001" profile="bika.mining:default"
      handler=".setuphandlers.upgrade" />

  <genericsetup:upgradeStep title="Move Matrix References to SENAITE setup"
      description="Preserve existing Matrix References in the new setup folder"
      source="1001" destination="1002" profile="bika.mining:default"
      handler=".setuphandlers.setup_matrixreferences" />

</configure>

<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="bika.mining">

  <i18n:registerTranslations directory="locales" />

  <!--
    Be careful if you use general includeDependencies, it can have side effects!
    Better import explicit packages or configurations ;)
  -->
  <!--<includeDependencies package="." />-->

  <include package=".browser" />
  <include package=".extenders" />
  <adapter for="zope.interface.Interface"
      provides="senaite.core.interfaces.IIdServerVariables"
      factory=".idserver.ReportVariables" />
  <subscriber for="Products.CMFCore.interfaces.ISiteRoot
                   zope.traversing.interfaces.IBeforeTraverseEvent"
      handler=".events.prioritize_mining_layer" />
  <include file="tat.zcml" />
  <include file="sampleimport.zcml"
      zcml:condition="installed senaite.sampleimporter" />

  <adapter name="bika.mining.matrixreference.info"
      for=".interfaces.IMatrixReference"
      provides="bika.lims.interfaces.IAddSampleObjectInfo"
      factory=".adapters.MatrixReferenceInfo" />
  <adapter name="bika.mining.sampletemplate.info"
      for="senaite.core.interfaces.ISampleTemplate"
      provides="bika.lims.interfaces.IAddSampleObjectInfo"
      factory=".adapters.SampleTemplateInfo" />
  <subscriber for="bika.lims.interfaces.IAnalysisRequest
                   zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".events.initialize_sample" />
  <subscriber for="senaite.core.interfaces.ISampleTemplate
                   zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".events.populate_sample_template" />
  <subscriber for="senaite.core.interfaces.ISampleTemplate
                   zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".events.populate_sample_template" />
  <subscriber for="bika.lims.interfaces.IAnalysisRequest
                   Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".events.after_transition" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="BIKA MINING"
      directory="profiles/default"
      description="Installs the bika.mining add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="bika.mining (uninstall)"
      directory="profiles/uninstall"
      description="Uninstalls the bika.mining add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.uninstall"
      />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="bika.mining-hiddenprofiles"
      />

  <!-- -*- extra stuff goes here -*- -->
  <genericsetup:upgradeStep title="Install mining sample attributes"
      description="Add mining lookup tables and template defaults"
      source="1000" destination="1001" profile="bika.mining:default"
      handler=".setuphandlers.upgrade" />

  <genericsetup:upgradeStep title="Move mining lookup folders to SENAITE setup"
      description="Preserve existing mining records in the new setup folder"
      source="1001" destination="1002" profile="bika.mining:default"
      handler=".setuphandlers.setup_mining_folders" />

  <genericsetup:upgradeStep title="Apply Sample target turnaround times"
      description="Refresh Sample due dates and published turnaround values"
      source="1002" destination="1003" profile="bika.mining:default"
      handler=".setuphandlers.upgrade_sample_tat" />

  <genericsetup:upgradeStep title="Configure mining XLSX filenames"
      description="Use ResultsReport ID Server formatting for results workbooks"
      source="1003" destination="1004" profile="bika.mining:default"
      handler=".idserver.setup_xlsx_format" />

  <genericsetup:upgradeStep title="Configure mining Sampling Methods"
      description="Reuse Sampling Deviations for Grab, Composite and Profile/Inventory"
      source="1004" destination="1005" profile="bika.mining:default"
      handler=".setuphandlers.setup_sampling_methods" />

  <genericsetup:upgradeStep title="Use Sampling Method on mining templates"
      description="Replace the Composite option with a Sampling Method lookup"
      source="1005" destination="1006" profile="bika.mining:default"
      handler=".setuphandlers.setup_template_sampling_method" />

</configure>
